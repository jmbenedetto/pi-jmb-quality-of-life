{
  "name": "pi-jmb-quality-of-life",
  "version": "1.0.0",
  "description": "Personal Pi quality-of-life package: session scratch cleanup, OneDrive path guard, and concise runtime context.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "cleanup",
    "temporary-files",
    "onedrive",
    "path-length",
    "runtime-context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmbenedetto/pi-jmb-quality-of-life.git"
  },
  "homepage": "https://github.com/jmbenedetto/pi-jmb-quality-of-life#readme",
  "bugs": {
    "url": "https://github.com/jmbenedetto/pi-jmb-quality-of-life/issues"
  },
  "files": [
    "extensions",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/cleanup-agent-tmp.ts",
      "./extensions/path-length-guard.ts",
      "./extensions/runtime-context.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:startup": "node tests/startup-proof.mjs node_modules/@earendil-works/pi-coding-agent .tmp/startup-proof-sdk",
    "check": "npm run typecheck && npm test && npm run test:startup"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
